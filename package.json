{
  "name": "piphin-hub",
  "productName": "Arasaka Central",
  "version": "1.10.1",
  "description": "Arasaka Central: baixe, atualize e gerencie seus apps",
  "main": "main.js",
  "author": "Piphin Studio",
  "license": "PolyForm-Strict-1.0.0",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "check": "node scripts/check.js",
    "dist": "electron-builder --win --publish never && node scripts/make-patch.js",
    "release": "node scripts/release.js",
    "ui-icons": "node scripts/make-ui-icons.js",
    "dist:linux": "electron-builder --linux --x64 --publish never && node scripts/fix-linux-tar.js && node scripts/make-patch.js"
  },
  "build": {
    "appId": "studio.piphin.hub",
    "productName": "Arasaka Central",
    "copyright": "Piphin Studio",
    "files": [
      "main.js",
      "preload.js",
      "module-preload.js",
      "catalog.json",
      "lib/**",
      "web/**",
      "icons/**",
      "i18n/*.json",
      "!i18n/config.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/hub.ico",
      "signAndEditExecutable": false,
      "artifactName": "Arasaka-Central-${version}-win-x64.${ext}"
    },
    "asar": false,
    "linux": {
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/hub.png",
      "executableName": "piphin-hub",
      "category": "Utility",
      "artifactName": "Arasaka-Central-${version}-linux-x64.${ext}",
      "extraFiles": [
        {
          "from": "linux/instalar.sh",
          "to": "instalar.sh"
        }
      ],
      "desktop": {
        "entry": {
          "Name": "Arasaka Central",
          "StartupWMClass": "arasaka-central"
        }
      }
    }
  },
  "devDependencies": {
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4",
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "lucide-static": "^1.59.0"
  }
}
